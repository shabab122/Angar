APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/angar?replicaSet=rs0&directConnection=true
MONGODB_DB=angar
COOKIE_SECRET=
STAFF_ADMIN_PASSWORD=
STAFF_KITCHEN_PASSWORD=
STAFF_WAITER_PASSWORD=
STAFF_CASHIER_PASSWORD=

# Optional online payment credentials (server only). Sandbox is the default.
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_PUBLIC_ORIGIN=

# Optional account emails. Use outbox only for local testing; smtp for real email.
MAIL_MODE=off
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Private application backup key. Keep a separate secure copy for recovery.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=

# Optional customer notifications. External services require your own credentials.
SMS_MODE=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WEB_PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# Staff authenticator secrets. Preserve this key with your private recovery material.
MFA_ENCRYPTION_KEY=
STAFF_REQUIRE_2FA_ADMIN=false

# Optional private S3-compatible off-site backups. Configure your own bucket.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=angar-backups/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_SESSION_TOKEN=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_USE_DEFAULT_CREDENTIALS=false

# Optional operator-configured ESC/POS TCP printer. Automatic sending is off until enabled by admin.
KITCHEN_PRINTER_HOST=
KITCHEN_PRINTER_PORT=9100
KITCHEN_PRINTER_COLUMNS=42
KITCHEN_PRINTER_CUT=false

# Optional staff-only email digest recipients, comma-separated. Existing SMTP/outbox settings apply.
STAFF_ALERT_EMAIL_TO=

# Optional courier adapter (HTTPS JSON contract in COURIER_ADAPTER.md). Manual delivery remains available.
COURIER_NAME=
COURIER_API_URL=
COURIER_API_TOKEN=
COURIER_WEBHOOK_SECRET=

# Optional native eCourier merchant API. Existing generic adapter stays the default.
COURIER_PROVIDER=generic
ECOURIER_MODE=sandbox
ECOURIER_API_KEY=
ECOURIER_API_SECRET=
ECOURIER_USER_ID=

# Technical alerts; SMTP configuration above applies. Enable after setting recipients.
MONITOR_EMAIL_ENABLED=false
MONITOR_EMAIL_TO=
# Run monitor:watch in an independent process/host to detect downtime.
MONITOR_URL=
MONITOR_STATE_FILE=
