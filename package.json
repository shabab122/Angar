{
  "name": "angar-kitchen",
  "version": "2.6.0",
  "private": true,
  "description": "React restaurant website with QR ordering, table billing and a staff workspace.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "tables": "node --env-file-if-exists=.env scripts/tables.js",
    "build": "node scripts/fonts.js && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js --dev",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=2 test/*.test.js",
    "mail:outbox": "node --env-file-if-exists=.env scripts/mail-outbox.js",
    "backup:create": "node --env-file-if-exists=.env scripts/backup.js create",
    "backup:verify": "node --env-file-if-exists=.env scripts/backup.js verify",
    "backup:restore": "node --env-file-if-exists=.env scripts/backup.js restore",
    "notifications:outbox": "node --env-file-if-exists=.env scripts/notification-outbox.js",
    "backup:remote-list": "node --env-file-if-exists=.env scripts/backup-cloud.js list",
    "backup:fetch": "node --env-file-if-exists=.env scripts/backup-cloud.js fetch",
    "mfa:recover": "node --env-file-if-exists=.env scripts/mfa-recover.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "1.72.0",
    "mongodb": "^7.0.0",
    "nodemailer": "^10.6.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.9.0",
    "sharp": "0.35.5",
    "web-push": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-bengali": "^5.2.8",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  }
}
